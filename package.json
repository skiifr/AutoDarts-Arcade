{
  "name": "autodarts-arcade",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/devtools/*",
    "packages/*"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p packages/event-schema && tsc -p packages/engine && tsc -p packages/games && tsc -p packages/adapters && tsc -p packages/platform && tsc -p packages/ui-kit && tsc -p apps/arcade && tsc -p apps/devtools/fake-board && tsc -p apps/devtools/fault-proxy",
    "test": "vitest run",
    "check": "yarn lint && yarn typecheck && yarn test",
    "web": "yarn --cwd apps/arcade web",
    "export:web": "yarn --cwd apps/arcade export:web",
    "fake-board": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./apps/devtools/fake-board/register.mjs apps/devtools/fake-board/src/main.ts",
    "fault-proxy": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./apps/devtools/fault-proxy/register.mjs apps/devtools/fault-proxy/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
